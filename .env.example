# Admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-session-secret

# Supabase REST storage. If omitted, local API tests use /tmp/wwmm-reservations.json.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_RESERVATIONS_TABLE=reservations
SUPABASE_STORAGE_BUCKET=reservation-photos

# Email notification via Resend
RESEND_API_KEY=re_your_key
NOTIFY_FROM_EMAIL=wwmm <no-reply@wwmm.co>
NOTIFY_ADMIN_EMAIL=admin@wwmm.co

# SMS notification via a webhook adapter such as Solapi/Aligo middleware
SMS_WEBHOOK_URL=https://your-sms-webhook.example.com/send
SMS_WEBHOOK_TOKEN=optional-webhook-token
NOTIFY_ADMIN_PHONE=01000000000
